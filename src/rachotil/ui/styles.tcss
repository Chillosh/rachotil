Screen {
    align: center middle;
}

#menu-container {
    padding: 1;
    background: $surface;
    border: double $accent;
    width: 50;
    height: auto;
}

#menu-search {
    margin-bottom: 1;
}

#dashboard-main, #services-main, #firewall-main, #settings-main, #docker-main, #fm-main, #net-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#dashboard-title, #services-title, #firewall-title, #settings-title, #docker-title, #fm-title, #net-title {
    margin-bottom: 1;
    text-style: bold;
}

#dashboard-content {
    height: 1fr;
    width: 100%;
}

.dashboard-box {
    border: solid cyan;
    padding: 1 2;
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

#services-actions, #firewall-controls, #firewall-add-rule, #docker-controls, #fm-controls, #net-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#services-actions Button, #firewall-controls Button, #firewall-add-rule Button, #docker-controls Button, #fm-controls Button, #net-controls Button {
    margin-right: 1;
}

#firewall-add-rule Input {
    width: 30;
    margin-right: 1;
}

#services-table, #firewall-table, #net-table {
    height: 1fr;
    width: 100%;
    border: solid blue;
    margin-bottom: 1;
}

.status-display {
    height: 8;
    width: 100%;
    border: solid $secondary;
}

.settings-card {
    width: 100%;
    height: auto;
    border: solid $primary;
    background: $surface;
    padding: 1;
    margin-bottom: 2;
}

.card-label {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#theme-panel {
    margin-left: 1;
}

.card-buttons Button {
    margin-right: 2;
}

#docker-content {
    height: 1fr;
    width: 100%;
    margin-bottom: 1;
}

#docker-table {
    width: 50%;
    height: 100%;
    border: solid blue;
    margin-right: 1;
}

#docker-log-container {
    width: 50%;
    height: 100%;
    border: solid cyan;
    padding: 1;
}

#docker-log-title {
    width: 100%;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#docker-log-view {
    width: 100%;
    height: 1fr;
    background: black;
    color: #aaaaaa;
}

#fm-path-label {
    width: auto;
    margin-right: 1;
    text-style: bold;
    color: $accent;
}

#fm-current-path {
    width: 1fr;
    border: solid $primary;
    background: $surface;
    padding: 0 1;
    margin-right: 1;
}

#fm-table {
    height: 1fr;
    width: 100%;
    border: solid cyan;
    margin-bottom: 1;
}

#yaml_not_inst {
    color: #555555;
}

.light-layout Screen {
    background: #f0f0f0;
    color: #1a1a1a;
}

.light-layout .settings-card {
    border: solid #000000;
    background: #ffffff;
}

.cyber-layout Screen {
    background: #050505;
    color: #00ff00;
}

.cyber-layout .settings-card {
    border: double #ff00ff;
    background: #111111;
}

.cyber-layout .card-label {
    color: #00ffff;
}

.solarized-layout Screen {
    background: #002b36;
    color: #839496;
}

.solarized-layout .settings-card {
    border: solid #2aa198;
    background: #073642;
}

.solarized-layout .card-label {
    color: #b58900;
}

.retro-layout Screen {
    background: #0000aa;
    color: #aaaaaa;
}

.retro-layout .settings-card {
    border: solid #ffffff;
    background: #0000aa;
}

.retro-layout .card-label {
    color: #ffffff;
    text-style: bold;
}

#backup-main, #snapshot-main, #mgmt-main, #stats-main {
    height: 100%;
    width: 100%;
    padding: 1;
}
#backup-title, #snapshot-title, #mgmt-title, #stats-title {
    margin-bottom: 1;
    text-style: bold;
}
#backup-controls, #snapshot-controls, #mgmt-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}
#backup-controls Input { width: 40; margin-right: 1; }
#backup-controls Button, #snapshot-controls Button, #mgmt-controls Button { margin-right: 1; }
#snapshot-table { height: 1fr; width: 100%; border: solid blue; margin-bottom: 1; }
#mgmt-log, #backup-log { height: 1fr; width: 100%; border: solid cyan; }
.stats-box { border: solid green; padding: 1; width: 100%; height: auto; margin-bottom: 1; }