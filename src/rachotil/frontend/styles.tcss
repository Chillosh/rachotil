Screen {
    background: #1a1a1a;
}

Log {
    height: 1fr;
    background: black;
    color: lightgreen;
}

MenuScreen {
    align: center middle;
    background: black 50%;
}

StatsSettingsModal {
    align: center middle;
    background: black 40%;
}

OptionList {
    width: 40;
    height: auto;
    border: double $accent;
    background: $surface;
}

Horizontal {
    width: auto;
    height: 3;
    align: center middle;
    margin-top: 1;
}

#save {
    background: green 60%;
}

#cancel {
    background: red 60%;
}

#mgmt_title {
    margin: 1 2;
    text-style: bold;
}

#mgmt_sections {
    height: auto;
    margin: 0 1;
}

#mgmt_controls {
    height: auto;
    margin: 0 1;
}

/* backup */

#backup-main {
    height: 100%;
    width: 100%;
    padding: 1;
    overflow-y: scroll;
}

#backup-title {
    margin-bottom: 1;
    text-style: bold;
}

#backup-dirs-container {
    height: auto;
    max-height: 10;
    width: 100%;
    border: solid blue;
    padding: 1;
    margin-bottom: 1;
}

.horizontal-container {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.column {
    width: 1fr;
    height: auto;
    margin: 0 1;
}

#backup-additional, #backup-custom-selected {
    border: solid green;
    padding: 1;
    height: auto;
}

#search-input {
    margin-bottom: 1;
}

#search-results-list, #custom-dirs-list {
    height: 6;
    border: solid cyan;
}

#backup-options {
    height: auto;
    width: 100%;
    border: solid yellow;
    padding: 1;
    margin-bottom: 1;
}

#backup-buttons {
    width: auto;
    height: auto;
    margin-bottom: 1;
}

.status-display {
    width: 100%;
    height: 10;
    border: solid magenta;
    background: black;
    color: lightgreen;
    margin-top: 1;
}

/*Snapshoy*/

#snapshot-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#snapshot-title {
    margin-bottom: 1;
    text-style: bold;
}

#snapshot-create-container {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#snapshot-desc-input {
    width: 1fr;
    margin-right: 1;
}

#btn-create-snap {
    width: auto;
}

#snapshot-table-container {
    height: 1fr;
    width: 100%;
    border: solid cyan;
    margin-bottom: 1;
}

#snapshot-table {
    height: 100%;
    width: 100%;
}

#snapshot-actions {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#snapshot-actions Button {
    margin-right: 1;
}

/* Dashboard */

#dashboard-main, #services-main, #firewall-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#dashboard-title, #services-title, #firewall-title {
    margin-bottom: 1;
    text-style: bold;
}

#dashboard-content {
    height: 1fr;
    width: 100%;
}

.dashboard-box {
    border: solid cyan;
    padding: 1 2;
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

#services-actions, #firewall-controls, #firewall-add-rule {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#services-actions Button, #firewall-controls Button, #firewall-add-rule Button {
    margin-right: 1;
}

#firewall-add-rule Input {
    width: 30;
    margin-right: 1;
}

#services-table, #firewall-table {
    height: 1fr;
    width: 100%;
    border: solid blue;
    margin-bottom: 1;
}

#menu-container {
    padding: 1;
    background: $surface;
    border: double $accent;
    width: 50;
    height: auto;
}

#menu-search {
    margin-bottom: 1;
}

#settings-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#settings-title {
    margin-bottom: 2;
    text-style: bold;
}

.settings-card {
    width: 100%;
    height: auto;
    border: solid $primary;
    background: $surface;
    padding: 1;
    margin-bottom: 2;
}

.card-label {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#theme-panel {
    margin-left: 1;
}

.card-buttons Button {
    margin-right: 2;
}

.light-layout Screen {
    background: #f0f0f0;
    color: #1a1a1a;
}

.light-layout .settings-card {
    border: solid #000000;
    background: #ffffff;
}

.cyber-layout Screen {
    background: #050505;
    color: #00ff00;
}

.cyber-layout .settings-card {
    border: double #ff00ff;
    background: #111111;
}

.cyber-layout .card-label {
    color: #00ffff;
}

.solarized-layout Screen {
    background: #002b36;
    color: #839496;
}

.solarized-layout .settings-card {
    border: solid #2aa198;
    background: #073642;
}

.solarized-layout .card-label {
    color: #b58900;
}

.retro-layout Screen {
    background: #0000aa;
    color: #aaaaaa;
}

.retro-layout .settings-card {
    border: solid #ffffff;
    background: #0000aa;
}

.retro-layout .card-label {
    color: #ffffff;
    text-style: bold;
}

/*File managr*/

#fm-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#fm-title {
    margin-bottom: 1;
    text-style: bold;
}

#fm-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    align: left middle;
}

#fm-path-label {
    width: auto;
    margin-right: 1;
    text-style: bold;
    color: $accent;
}

#fm-current-path {
    width: 1fr;
    border: solid $primary;
    background: $surface;
    padding: 0 1;
    margin-right: 1;
}

#fm-controls Button {
    margin-left: 1;
}

#fm-table {
    height: 1fr;
    width: 100%;
    border: solid cyan;
    margin-bottom: 1;
}

#fm-actions {
    height: 3;
    margin-bottom: 1;
}

#fm-input {
    width: 1fr;
}

/*docker test*/

#docker-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#docker-title {
    margin-bottom: 1;
    text-style: bold;
}

#docker-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#docker-controls Button {
    margin-right: 1;
}

#docker-content {
    height: 1fr;
    width: 100%;
    margin-bottom: 1;
}

#docker-table {
    width: 50%;
    height: 100%;
    border: solid blue;
    margin-right: 1;
}

#docker-log-container {
    width: 50%;
    height: 100%;
    border: solid cyan;
    padding: 1;
}

#docker-log-title {
    width: 100%;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#docker-log-view {
    width: 100%;
    height: 1fr;
    background: black;
    color: #aaaaaa;
}

#net-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#net-title {
    margin-bottom: 1;
    text-style: bold;
}

#net-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#net-controls Button {
    margin-right: 1;
}

#net-table {
    height: 1fr;
    width: 100%;
    border: solid blue;
    margin-bottom: 1;
}

#yaml_not_inst {
    color: #555555;
}