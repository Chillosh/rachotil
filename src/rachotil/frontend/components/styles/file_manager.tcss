#fm-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#fm-title {
    margin-bottom: 1;
    text-style: bold;
}

#fm-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    align: left middle;
}

#fm-path-label {
    width: auto;
    margin-right: 1;
    text-style: bold;
    color: $accent;
}

#fm-current-path {
    width: 1fr;
    border: solid $primary;
    background: $surface;
    padding: 0 1;
    margin-right: 1;
}

#fm-controls Button {
    margin-left: 1;
}

#fm-table {
    height: 1fr;
    width: 100%;
    border: solid cyan;
    margin-bottom: 1;
}

#fm-actions {
    height: 3;
    margin-bottom: 1;
}

#fm-input {
    width: 1fr;
}
