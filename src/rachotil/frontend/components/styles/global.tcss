Screen {
    background: #1a1a1a;
}

Log {
    height: 1fr;
    background: black;
    color: lightgreen;
}

Horizontal {
    width: auto;
    height: 3;
    align: center middle;
    margin-top: 1;
}

.status-display {
    height: 6;
    border: solid green;
}

.light-layout Screen {
    background: #f0f0f0;
    color: #1a1a1a;
}

.light-layout .settings-card {
    border: solid #000000;
    background: #ffffff;
}

.cyber-layout Screen {
    background: #050505;
    color: #00ff00;
}

.cyber-layout .settings-card {
    border: double #ff00ff;
    background: #111111;
}

.cyber-layout .card-label {
    color: #00ffff;
}

.solarized-layout Screen {
    background: #002b36;
    color: #839496;
}

.solarized-layout .settings-card {
    border: solid #2aa198;
    background: #073642;
}

.solarized-layout .card-label {
    color: #b58900;
}

.retro-layout Screen {
    background: #0000aa;
    color: #aaaaaa;
}

.retro-layout .settings-card {
    border: solid #ffffff;
    background: #0000aa;
}

.retro-layout .card-label {
    color: #ffffff;
    text-style: bold;
}
