#dashboard-main, #services-main, #firewall-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#dashboard-title, #services-title, #firewall-title {
    margin-bottom: 1;
    text-style: bold;
}

#dashboard-content {
    height: 1fr;
    width: 100%;
}

.dashboard-box {
    border: solid cyan;
    padding: 1 2;
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

#services-actions, #firewall-controls, #firewall-add-rule {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#services-actions Button, #firewall-controls Button, #firewall-add-rule Button {
    margin-right: 1;
}

#firewall-add-rule Input {
    width: 30;
    margin-right: 1;
}

#services-table, #firewall-table {
    height: 1fr;
    width: 100%;
    border: solid blue;
    margin-bottom: 1;
}

#menu-container {
    padding: 1;
    background: $surface;
    border: double $accent;
    width: 50;
    height: auto;
}

#menu-search {
    margin-bottom: 1;
}
