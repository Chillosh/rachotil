#net-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#net-title {
    margin-bottom: 1;
    text-style: bold;
}

#net-controls {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#net-controls Button {
    margin-right: 1;
}

#net-table {
    height: 1fr;
    width: 100%;
    border: solid blue;
    margin-bottom: 1;
}
