#services-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#services-title {
    margin-bottom: 1;
    text-style: bold;
}

#services-actions {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#services-actions Button {
    margin-right: 1;
}

#services-table {
    height: 1fr;
    width: 100%;
    border: solid blue;
    margin-bottom: 1;
}
