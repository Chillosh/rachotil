#snapshot-main {
    height: 100%;
    width: 100%;
    padding: 1;
}

#snapshot-title {
    margin-bottom: 1;
    text-style: bold;
}

#snapshot-create-container {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#snapshot-desc-input {
    width: 1fr;
    margin-right: 1;
}

#btn-create-snap {
    width: auto;
}

#snapshot-table-container {
    height: 1fr;
    width: 100%;
    border: solid cyan;
    margin-bottom: 1;
}

#snapshot-table {
    height: 100%;
    width: 100%;
}

#snapshot-actions {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#snapshot-actions Button {
    margin-right: 1;
}
